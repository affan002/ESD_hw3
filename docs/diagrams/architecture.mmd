%% Architecture of the sensor ingestion stack (A3: three replicas behind Envoy).
%% Source of truth for docs/diagrams/architecture.svg / .png; rendered by
%% scripts/render_diagram.sh. Every arrow matches docker-compose.yml and the
%% configs in monitoring/. Shared-state and failure detail are in REPORT.md, not here.
flowchart LR
    subgraph clients["Clients"]
        LOAD["lb_load.py<br/>fixed rate · open loop"]
        CLI["browser · Python callers<br/>(simulator: profile sim)"]
    end

    subgraph lb["Load balancer"]
        ENVOY["Envoy<br/>:8000 HTTP · :50051 gRPC (HTTP/2)<br/>admin :9901"]
    end

    subgraph replicas["sensor-api replicas (Compose scaling)"]
        A["replica A<br/>HTTP :8000 + gRPC :50051"]
        B["replica B<br/>HTTP :8000 + gRPC :50051"]
        C["replica C<br/>HTTP :8000 + gRPC :50051"]
        DB[("SQLite on volume<br/>shared by A, B, C")]
    end

    subgraph metrics["Metrics"]
        PROM[("Prometheus :9090<br/>5 s scrape")]
        GRAF["Grafana :3000<br/>lb-replicas dashboard"]
    end

    subgraph logs["Logs"]
        FB["Filebeat<br/>app + envoy containers"]
        ES[("Elasticsearch :9200<br/>sensor-logs")]
        KB["Kibana :5601"]
    end

    LOAD -- "HTTP + gRPC" --> ENVOY
    CLI --> ENVOY
    ENVOY -- "per request / per call" --> A
    ENVOY -.-> B
    ENVOY -.-> C
    A --- DB
    B --- DB
    C --- DB
    replicas -- "JSON logs" --> FB
    ENVOY -- "JSON access log" --> FB
    FB --> ES
    KB -- "KQL" --> ES
    PROM -- "/metrics, each replica directly" --> replicas
    PROM -- "/stats/prometheus" --> ENVOY
    GRAF -- "PromQL" --> PROM
